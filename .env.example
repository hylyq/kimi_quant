# =============================================================================
#  Kimi Quant — Environment Variables
#  Copy to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
#  Kimi / Moonshot API
# ---------------------------------------------------------------------------
MOONSHOT_API_KEY=sk-your-key-here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
# Kimi reasoning effort. Leave empty to use REASONING_EFFORT.
#   "max" | "high" | "medium" | "low" | "minimal" | "off"
# KIMI_REASONING_EFFORT=

# ---------------------------------------------------------------------------
#  DeepSeek API (automatic fallback when Kimi fails; leave blank for Kimi-only)
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
# DeepSeek reasoning effort. Leave empty to use REASONING_EFFORT.
#   "max" | "high" | "medium" | "low" | "minimal" | "off"
# DEEPSEEK_REASONING_EFFORT=

# ---------------------------------------------------------------------------
#  LLM Parameters
# ---------------------------------------------------------------------------
# Primary model: "kimi" or "deepseek". The other becomes automatic fallback.
PRIMARY_LLM=kimi
# Global default reasoning effort — fallback when per-provider settings are empty.
# Auto-translated to each model's native API form (Kimi→reasoning_effort, DeepSeek→thinking).
REASONING_EFFORT=max
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ---------------------------------------------------------------------------
#  Hyperliquid
# ---------------------------------------------------------------------------
# Wallet private key (hex, without 0x prefix). Required for live trading.
HYPERLIQUID_PRIVATE_KEY=
# true = testnet (free), false = mainnet (real funds)
HYPERLIQUID_TESTNET=true
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz

# ---------------------------------------------------------------------------
#  Trading Parameters
# ---------------------------------------------------------------------------
TRADING_PAIR=BTC
MAX_POSITION_SIZE=0.01        # BTC, not USD
MIN_CONFIDENCE=0.7
MAX_LEVERAGE=3

# ---------------------------------------------------------------------------
#  Strategy
# ---------------------------------------------------------------------------
# "single" (1 LLM call) or "debate" (Bull+Bear+Hold+Judge, 4-7 calls)
STRATEGY_MODE=single
# Default cycle interval in seconds. LLM can override via next_interval.
TRADING_INTERVAL=600
# Hard bounds for LLM-suggested intervals (seconds).
# MIN_INTERVAL=300
# MAX_INTERVAL=10800
# Dry-run: analyze and simulate, but don't execute real orders.
DRY_RUN=true

# -- Judge (debate mode only) ------------------------------------------------
# Judge's primary model: "kimi" or "deepseek". Empty = use PRIMARY_LLM.
# Recommended: "kimi" (strong reasoning for final rulings).
JUDGE_PRIMARY_LLM=
# Judge-specific model version (e.g. deepseek-v4-pro, kimi-k3). Empty = use provider default.
# JUDGE_MODEL=
# Judge's temperature (lower = more deterministic).
JUDGE_TEMPERATURE=0.05
# Judge-specific reasoning effort. Empty = use per-provider or global setting.
# Highest priority — overrides everything else for the Judge.
# JUDGE_REASONING_EFFORT=

# -- Rebuttal round (debate mode only) ----------------------------------------
# Debaters counter each other before Judge rules (+3 LLM calls/cycle).
# Only enable after validating basic debate works.
# DEBATE_REBUTTAL_ENABLED=false

# ---------------------------------------------------------------------------
#  Cache (debate mode only)
# ---------------------------------------------------------------------------
# Wait after cache-warmup for DeepSeek disk cache to flush (seconds).
# Default 2.0. Set 0 to disable.
# CACHE_WARMUP_DELAY=2.0

# ---------------------------------------------------------------------------
#  Order Monitor (real-time WebSocket + Flash LLM notifications)
# ---------------------------------------------------------------------------
# Enable real-time order status tracking.
MONITOR_ENABLED=true
# Flash model for generating push notifications (cheap, fast, no reasoning).
MONITOR_FLASH_MODEL=deepseek-v4-flash
# API key and base URL default to DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL if empty.
# MONITOR_FLASH_API_KEY=
# MONITOR_FLASH_BASE_URL=

# ---------------------------------------------------------------------------
#  Notifications (optional — via larky Redis Pub/Sub)
# ---------------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# ---------------------------------------------------------------------------
#  Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
